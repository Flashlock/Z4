            "type": "array",
            "title": "Groups"
          }
        },
        "type": "object",
        "required": [
          "groups"
        ],
        "title": "MarketProjection"
      },
      "MarketplaceSyncRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "incremental",
              "full"
            ],
            "title": "Mode",
            "default": "incremental"
          }
        },
        "type": "object",
        "title": "MarketplaceSyncRequest"
      },
      "MarketplaceSyncResult": {
        "properties": {
          "sources": {
            "items": {
              "type": "string"
