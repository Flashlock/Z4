              "$ref": "#/components/schemas/ListingView"
            },
            "type": "array",
            "title": "Listings"
          }
        },
        "type": "object",
        "required": [
          "component",
          "listings"
        ],
        "title": "ComponentGroupView"
      },
      "ComponentView": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "manufacturer": {
            "type": "string",
            "title": "Manufacturer"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "id",
          "category",
          "manufacturer",
          "model"
        ],
        "title": "ComponentView"
      },
      "DraftBuildView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
