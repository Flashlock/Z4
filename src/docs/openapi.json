            "title": "Component Id"
          },
          "marketplace": {
            "type": "string",
            "title": "Marketplace"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "listing_url": {
            "type": "string",
            "title": "Listing Url"
          },
          "seller": {
            "type": "string",
            "title": "Seller"
          },
          "condition": {
            "type": "string",
            "title": "Condition"
          },
          "reliability_score": {
            "type": "number",
            "title": "Reliability Score"
          },
          "price_cents": {
            "type": "integer",
            "title": "Price Cents"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url",
            "default": ""
          },
          "manufacturer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manufacturer"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          }
        },
        "type": "object",
        "required": [
          "id",
          "marketplace",
          "title",
          "listing_url",
          "seller",
          "condition",
          "reliability_score",
          "price_cents",
          "currency"
        ],
        "title": "ListingView"
      },
      "LockDraftBody": {
        "properties": {
          "draftId": {
            "type": "string",
            "title": "Draftid"
          }
        },
        "type": "object",
        "required": [
          "draftId"
        ],
        "title": "LockDraftBody"
      },
